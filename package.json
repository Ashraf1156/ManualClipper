{
  "name": "manual-clipper",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.1",
    "wait-on": "^9.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/lib-storage": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@zernio/node": "^0.2.580",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "com.manualclipper.app",
    "productName": "Manual Clipper",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "electron/assets/**"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
